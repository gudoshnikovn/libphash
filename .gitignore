# Object files and libraries
*.o
*.a
*.so
*.dylib
*.dll
obj/

# Executables (tests, benchmark)
test_*
/bench_hash
/bench_hash.d
/bench_hash.dSYM/
!tests/**/test_*.c
!tests/**/*.h

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build artifacts
dist/
build/
.cache/
generated/

# Test images (if generated)
tests/output_*.jpeg

# fuzz_load's working corpus. libFuzzer only ever writes new units into the
# *first* directory on its command line; tests/fuzz/seeds (tracked) is passed second,
# read-only. The working corpus is cached across CI runs, never committed.
tests/fuzz/corpus/

# Coverage and GCov data
docs/coverage/

# Generated into the site's source by scripts/site.sh: the API reference, and the figures
# tools/site/render.py draws
docs/api/
docs/assets/generated/
docs/project/corpus.md
# Python's bytecode cache, beside the site's modules in tools/site/
__pycache__/
*.gcda
*.gcno
*.gcov
src/*.gcda
src/*.gcno
src/**/*.gcda
src/**/*.gcno

# Claude Code agent worktrees (transient, per-session)
.claude/worktrees/

# Internal planning/review material — kept locally, never committed
tasks/
tmp/
CLAUDE.md
REVIEW_v2.0.0.md

# Downloaded papers (see docs/references.md). Kept out of git deliberately: these are
# copyrighted by IEEE, SPIE and others, and committing a PDF to a public repository
# redistributes it. The repository holds the citation and the DOI; the reader fetches
# the paper from the publisher.
papers/
