# API reference for include/libphash.h, generated from its doc comments.
# Built by scripts/api_docs.sh (`make docs`), which pins the Doxygen version; the HTML
# lands in build/api-docs/html/index.html. Any warning -- an undocumented public
# declaration, a @param that names no parameter -- fails the run, which is how CI keeps
# the header fully documented.

PROJECT_NAME           = libphash
PROJECT_BRIEF          = "Perceptual image hashing library in C"
INPUT                  = include/libphash.h docs/api-index.md
USE_MDFILE_AS_MAINPAGE = docs/api-index.md
OUTPUT_DIRECTORY       = build/api-docs
FULL_PATH_NAMES        = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
SORT_MEMBER_DOCS       = NO

# The declaration macros expand to nothing for the reference, so a function reads as
# its plain C signature.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = PH_API= PH_NODISCARD= "PH_DEPRECATED(msg)="

# A declaration's history after the release that added it (@since): each change of its
# contract as @changed{X.Y.Z} <what changed>, and its deprecation as
# @deprecated{X.Y.Z} <what to use instead>. scripts/check_symbol_versions.py reads the
# titles these expand to, and rejects a @deprecated without a version.
ALIASES                = "changed{1}=@par Changed in \1:^^" \
                         "deprecated{1}=@deprecated Deprecated in \1:"

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
# No graphs: one header has nothing to draw, and Graphviz would be one more dependency.
HAVE_DOT               = NO
GENERATE_LATEX         = NO
# Read by scripts/check_api_groups.py: every declaration must be in a topic.
GENERATE_XML           = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
