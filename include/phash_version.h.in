/* Generated from include/phash_version.h.in — do not edit by hand.
 * Single source of truth is the project version in CMakeLists.txt
 * (or, for the plain Makefile build, the copy generated by `scripts/gen_version.sh`). */
#ifndef PH_PHASH_VERSION_H
#define PH_PHASH_VERSION_H

#define PH_VERSION_MAJOR @PH_VERSION_MAJOR@
#define PH_VERSION_MINOR @PH_VERSION_MINOR@
#define PH_VERSION_PATCH @PH_VERSION_PATCH@
#define PH_VERSION_STRING "@PH_VERSION_STRING@"

/* Monotonic, comparable version number: 2.0.0 -> 2000000, 2.3.11 -> 2003011.
 * Each component gets 1000 slots, so no minor or patch up to 999 collides with
 * the next component up. */
#define PH_VERSION_NUMBER \
    (PH_VERSION_MAJOR * 1000000 + PH_VERSION_MINOR * 1000 + PH_VERSION_PATCH)

#endif /* PH_PHASH_VERSION_H */
