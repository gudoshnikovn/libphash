"IHDR"
"PLTE"
"IDAT"
"IEND"
"tRNS"
"gAMA"
"cHRM"
"sRGB"
"iCCP"
"sBIT"
"bKGD"
"tEXt"
"zTXt"
"iTXt"
"pHYs"
"eXIf"
"acTL"
"fcTL"
"fdAT"

